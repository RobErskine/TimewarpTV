# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/

# TimewarpTV
# Each box has its own config, kept on its media drive. Keep personal configs
# and library manifests out of the repo.
config.yaml
scripts/library.tsv
# Resume positions (normally on the media drive, next to config.yaml).
.nostalgiabox-state.json
.timewarptv-state.json
# Dev sandbox library + config (created by `scripts/make-dev-library.sh`).
config.dev.yaml
dev-media/
# Generated filler clips (created by `timewarptv --generate-assets`).
timewarptv/assets/*.mp4

# OS cruft
.DS_Store
Thumbs.db
